{
  "type": "dvrk_console:stereo_display@1.0.0",
  "name": "dvrk_display_hdmi",
  "dvrk_console_namespace": "console",
  "sinks": [
    "glimage"
  ],
  "stereo": {
    "stream": "unixfdsrc socket-path=/tmp/dvrk_display_hdmi_stereo.sock socket-type=abstract do-timestamp=true ! video/x-raw,format=I420,width=3840,height=1080",
    "eye_size": {
      "width": 1920,
      "height": 1080
    }
  },
  "preserve_size": true,
  "display_horizontal_offset_px": 0
}
