{
  "type": "dvrk_data:stereo_alignment@1.0.0",
  "name": "dvrk_display_hdmi",
  "unixfdsources": [
    {
      "name": "left",
      "socket_path": "/tmp/dvrk_display_hdmi_left.sock"
    },
    {
      "name": "right",
      "socket_path": "/tmp/dvrk_display_hdmi_right.sock"
    }
  ],
  "unixfdsinks": [
    {
      "stream": "stereo",
      "socket_path": "/tmp/dvrk_display_hdmi_stereo.sock"
    }
  ],
  "camera": {
    "size": {
      "width": 1920,
      "height": 1080
    },
    "crop": {
      "width": 1920,
      "height": 1080
    }
  },
  "preserve_size": true
}
