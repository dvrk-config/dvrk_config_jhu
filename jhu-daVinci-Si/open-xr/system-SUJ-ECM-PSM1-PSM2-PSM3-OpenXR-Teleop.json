/* -*- Mode: Javascript; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
/*
  JHU da Vinci Si patient cart controlled by the sawOpenXR Quest interface.

  The physical Si MTMs and console pedals/head sensor are replaced by
  sawOpenXR.  MTMR controls PSM1 and PSM3, while MTML controls PSM2.
*/
{
    "$id": "dvrk-system.schema.json",
    "$version": "1",
    "component_manager": {
        "components": [
            {
                "shared-library": "sawOpenXR",
                "class-name": "mtsOpenXR",
                "constructor-arg": {"Name": "OpenXR"},
                "configure-parameter": "sawOpenXR-dvrk-socket.json"
            }
        ]
    },
    "IOs": [
        {
            "name": "IO1",
            "port": "udpfw",
            "protocol": "broadcast-query-read-write"
        }
    ],
    "arms": [
        {
            "name": "SUJ",
            "type": "SUJ_Si",
            "arm_file": "kinematic/suj-si.json"
        },
        {
            "name": "ECM",
            "type": "ECM",
            "serial": "438610",
            "IO": "IO1",
            "base_frame": {"component": "SUJ", "interface": "ECM"}
        },
        {
            "name": "PSM1",
            "type": "PSM",
            "serial": "292409",
            "IO": "IO1",
            "base_frame": {"component": "SUJ", "interface": "PSM1"}
        },
        {
            "name": "PSM2",
            "type": "PSM",
            "serial": "586288",
            "IO": "IO1",
            "base_frame": {"component": "SUJ", "interface": "PSM2"}
        },
        {
            "name": "PSM3",
            "type": "PSM",
            "serial": "698534",
            "IO": "IO1",
            "base_frame": {"component": "SUJ", "interface": "PSM3"}
        },
        {
            "name": "MTML",
            "type": "MTM_GENERIC",
            "component": "OpenXR",
            "interface": "MTML"
        },
        {
            "name": "MTMR",
            "type": "MTM_GENERIC",
            "component": "OpenXR",
            "interface": "MTMR"
        }
    ],
    "consoles": [
        {
            "name": "console",
            "input_type": "COMPONENTS",
            "operator_present": {"component": "OpenXR", "interface": "Console/operator_present"},
            "clutch": {"component": "OpenXR", "interface": "Console/clutch"},
            "camera": {"component": "OpenXR", "interface": "Console/camera"},
            "teleop_PSMs": [
                {
                    "MTM": "MTMR",
                    "PSM": "PSM1",
                    "clutch": {"component": "OpenXR", "interface": "Console/clutch/MTMR"},
                    "configure_parameter": {
                        "MTM_is_haptic": false,
                        "align_MTM": false,
                        "use_MTM_linear_velocity": false,
                        "use_MTM_angular_velocity": false,
                        "ignore_jaw": false,
                        "start_gripper_threshold": 0.0,
                        "gripper_scaling": {"zero": 0.3490658504, "max": 1.7453292520},
                        "scale": 0.2
                    }
                },
                {
                    "MTM": "MTML",
                    "PSM": "PSM2",
                    "clutch": {"component": "OpenXR", "interface": "Console/clutch/MTML"},
                    "configure_parameter": {
                        "MTM_is_haptic": false,
                        "align_MTM": false,
                        "use_MTM_linear_velocity": false,
                        "use_MTM_angular_velocity": false,
                        "ignore_jaw": false,
                        "start_gripper_threshold": 0.0,
                        "gripper_scaling": {"zero": 0.3490658504, "max": 1.7453292520},
                        "scale": 0.2
                    }
                },
                {
                    "MTM": "MTMR",
                    "PSM": "PSM3",
                    "clutch": {"component": "OpenXR", "interface": "Console/clutch/MTMR"},
                    "configure_parameter": {
                        "MTM_is_haptic": false,
                        "align_MTM": false,
                        "use_MTM_linear_velocity": false,
                        "use_MTM_angular_velocity": false,
                        "ignore_jaw": false,
                        "start_gripper_threshold": 0.0,
                        "gripper_scaling": {"zero": 0.3490658504, "max": 1.7453292520},
                        "scale": 0.2
                    }
                }
            ],
            "teleop_ECMs": [
                {
                    "MTML": "MTML",
                    "MTMR": "MTMR",
                    "ECM": "ECM",
                    "configure_parameter": {
                        "MTM_is_haptic": false,
                        "check_MTMs_workspace": false,
                        "haptic_feedback_ratio": 0.0
                    }
                }
            ]
        }
    ]
}
