{
    "$id": "dvrk-system.schema.json",
    "$version": "1",
    "settings": {
        "path": ["two_force_dimensions"]
    },
    "component_manager": {
        "components": [
            {
                "shared-library": "sawForceDimensionSDK",
                "class-name": "mtsForceDimension",
                "constructor-arg": {
                    "Name": "ForceDimensionSDK"
                },
                "configure-parameter": "omega7-MTML-MTMR.json"
            },
            {
                "shared-library": "sawGenericInput",
                "class-name": "mtsEvdev",
                "constructor-arg": {
                    "Name": "Pedals",
                    "Period": 0.002
                },
                "configure-parameter": "sawGenericInput-dVRK-console.json"
            }
        ]
    },
    "IOs": [
        {
            "name": "IO1",
            "port": "udpfw",
            "protocol": "broadcast-query-read-write"
        }
    ],
    "arms": [
        {
            "name": "MTML",
            "type": "MTM_GENERIC",
            "component": "ForceDimensionSDK",
            "interface": "MTML"
        },
        {
            "name": "MTMR",
            "type": "MTM_GENERIC",
            "component": "ForceDimensionSDK",
            "interface": "MTMR"
        },
        {
            "name": "SUJ",
            "type": "SUJ_Si",
            "arm_file": "kinematic/suj-si.json"
        },
        {
            "name": "ECM",
            "type": "ECM",
            "serial": "438610",
            "IO": "IO1",
            "base_frame": {
                "component": "SUJ",
                "interface": "ECM"
            }
        },
        {
            "name": "PSM1",
            "type": "PSM",
            "serial": "334809",
            "IO": "IO1",
            "base_frame": {
                "component": "SUJ",
                "interface": "PSM1"
            }
        },
        {
            "name": "PSM2",
            "type": "PSM",
            "serial": "586288",
            "IO": "IO1",
            "base_frame": {
                "component": "SUJ",
                "interface": "PSM2"
            }
        },
        {
            "name": "PSM3",
            "type": "PSM",
            "serial": "698534",
            "IO": "IO1",
            "base_frame": {
                "component": "SUJ",
                "interface": "PSM3"
            }
        }
    ],
    "consoles": [
        {
            "name": "console",
            "input_type": "COMPONENTS",
            "clutch": {
                "component": "Pedals",
                "interface": "Clutch"
            },
            "camera": {
                "component": "Pedals",
                "interface": "Camera"
            },
            "operator_present": {
                "component": "Pedals",
                "interface": "OperatorPresent"
            },
            "teleop_PSMs": [
                {
                    "MTM": "MTMR",
                    "PSM": "PSM1",
                    "configure_parameter": {
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4,
                        "gripper_scaling": {
                            "zero": 0.25,
                            "max": 0.492
                        }
                    }
                },
                {
                    "MTM": "MTML",
                    "PSM": "PSM2",
                    "configure_parameter": {
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4,
                        "gripper_scaling": {
                            "zero": 0.25,
                            "max": 0.492
                        }
                    }
                },
                {
                    "MTM": "MTMR",
                    "PSM": "PSM3",
                    "configure_parameter": {
                        "align_MTM": false,
                        "start_gripper_threshold": 0.0,
                        "scale": 0.4,
                        "gripper_scaling": {
                            "zero": 0.25,
                            "max": 0.492
                        }
                    }
                }
            ],
            "teleop_ECMs": [
                {
                    "type": "TELEOP_ECM_ONE_HAND",
                    "MTM": "MTMR",
                    "ECM": "ECM",
                    "configure_parameter": {
                        "check_MTMs_workspace": false
                    }
                }
            ]
        }
    ]
}
